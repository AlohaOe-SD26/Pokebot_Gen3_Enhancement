{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/session-sync.ps1",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/block-blind-git-add.ps1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/advise-on-commit.ps1",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
