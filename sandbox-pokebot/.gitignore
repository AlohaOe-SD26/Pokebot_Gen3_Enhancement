*Thumbs.db*
__pycache__
.venv
.idea
.vs
.vscode

*.gba
.last-requirements-check
.last-update-check
build/
profiles/*
!profiles/.gitkeep
dist/
logs/
mgba/
roms/*
!roms/.gitkeep
stats/
stream/
# Fork divergence: upstream ignores plugins/ entirely (user-private files).
# Our custom-automation framework LIVES there and must be tracked; anything
# else a user drops in plugins/ stays ignored, like upstream intended.
plugins/*
!plugins/.gitkeep
!plugins/custom_modes_loader.py
!plugins/dashboard_autoopen.py
!plugins/shiny_alert_plugin.py
!plugins/gamepad_plugin.py
!plugins/macro_plugin.py
!plugins/backup_plugin.py
!plugins/game_cheats_plugin.py
!plugins/custom_modes/

# Sandbox A1: local backup archives are user data — never committed.
backups/
tests/last_frame_timeout.png
modules/web/static/stream-overlay/config.js
cache/
