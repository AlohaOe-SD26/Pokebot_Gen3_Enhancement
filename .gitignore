# --- Claude Code Project Kit starter .gitignore (extend per stack) ---
# Secrets - never commit these
.env
.env.*
*.pem
*.key

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Editor / tool noise
.vscode/
.idea/
*.bak
*.tmp

# Common build/dependency output (delete lines that don't apply)
node_modules/
dist/
build/
__pycache__/
*.pyc
bin/
obj/

# Project Kit run logs (local diagnostics)
PROJECT KIT/logs/
REMOTE START/logs/
# installer run logs (machine-local)
install.log
install.log.old
install_sandbox.log
install_sandbox.log.old

# Endless-run batch output (logs + LEDGER.md) — run artefacts, not source.
tools/story-dev/endless-runs/
tools/story-dev/saves/stalls/

# Endless Loop x4 mosaic previews written by repro_x4_mosaic.py — regenerable.
tools/story-dev/x4-preview/

# Crash dumps written by modules/exceptions_hook.py — diagnostic artefacts, not source.
sandbox-pokebot/crash-*.log
custom-pokebot/crash-*.log

# Decomp working copies — research agents extract these; never commit them (61MB, 11k files).
pokeemerald-master/
pe.tar.gz
pokeemerald-*/
tools/story-dev/.layout-cache/
# solve_victory_road.py's decomp download cache — re-fetchable, and it must NEVER be the
# source of truth for a tile claim (the script asserts byte lengths on every read).
tools/story-dev/.cache/

# Windows device-name artifacts: in Git Bash `2>NUL` creates a REAL 0-byte file called NUL
# instead of discarding output. One appeared on 2026-09-06 and nearly reached a commit.
NUL
nul
